# Basta a chave da OpenAI para tudo funcionar (transcricao + respostas).
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcionais. Quando presentes, tem prioridade sobre a OpenAI:
# Anthropic (Claude) para as respostas: https://platform.claude.com
# ANTHROPIC_API_KEY=
# Deepgram para a transcricao (permissao Member ou superior): https://console.deepgram.com
# DEEPGRAM_API_KEY=

# Forcar provedor quando houver mais de uma chave:
# LLM_PROVIDER=openai        # ou anthropic
# STT_PROVIDER=openai        # ou deepgram

# Modelos (padroes abaixo):
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-5-5
